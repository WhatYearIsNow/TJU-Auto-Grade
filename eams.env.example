# EAMS 查成绩助手配置
# 复制此文件为 eams.env 并填写你的信息

# 天津大学教务系统登录凭据
EAMS_USERNAME=你的学号
EAMS_PASSWORD=你的密码

# 查询配置（可选）
# CHECK_INTERVAL_MINUTES=15
# EAMS_ENTRY_URL=https://classes.tju.edu.cn/eams/homeExt.action
# EAMS_GRADE_URL=/eams/teach/grade/course/person!search.action
# EAMS_CAS_HOST=sso.tju.edu.cn

# QQ邮箱 SMTP 配置 (用于发送成绩报告)
# 授权码获取: QQ邮箱 → 设置 → 账户 → POP3/SMTP服务 → 开启 → 获取授权码
QQ_EMAIL=你的QQ号@qq.com
QQ_SMTP_CODE=你的QQ邮箱授权码
NOTIFY_EMAIL=接收通知的邮箱(可选，默认发给自己)

# 其他 SMTP 服务可覆盖以下配置（可选）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true

# 千问 API Key (可选，用于 AI 自动识别验证码)
# 获取: https://bailian.console.aliyun.com/
# DASHSCOPE_API_KEY=sk-xxxx

# 看门狗发现主程序停止时是否自动重启（可选，默认 true）
# WATCHDOG_AUTO_RESTART=true
