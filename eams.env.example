# EAMS 查成绩助手配置
# 复制此文件为 eams.env 并填写你的信息

# 天津大学教务系统登录凭据
EAMS_USERNAME=你的学号
EAMS_PASSWORD=你的密码

# QQ邮箱 SMTP 配置 (用于发送成绩报告)
# 授权码获取: QQ邮箱 → 设置 → 账户 → POP3/SMTP服务 → 开启 → 获取授权码
QQ_EMAIL=你的QQ号@qq.com
QQ_SMTP_CODE=你的QQ邮箱授权码
NOTIFY_EMAIL=接收通知的邮箱(可选，默认发给自己)
# 允许发送查询指令的邮箱（可选，默认取 NOTIFY_EMAIL）
# COMMAND_EMAIL=你的常用邮箱@example.com
# 可选的邮件指令口令；配置后，主题或正文必须包含该口令
# COMMAND_TOKEN=请替换为随机字符串

# 非 QQ 邮箱可覆盖 SMTP/IMAP 地址
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=你的发件邮箱
# SMTP_PASS=你的SMTP授权码
# IMAP_HOST=imap.qq.com
# IMAP_PORT=993
# IMAP_USER=你的收件邮箱
# IMAP_PASS=你的IMAP授权码

# 千问 API Key (可选，用于 AI 自动识别验证码)
# 获取: https://bailian.console.aliyun.com/
# DASHSCOPE_API_KEY=sk-xxxx
# VISION_MODEL=qwen3.5-ocr

# 运行参数（均可选）
# CHECK_INTERVAL_MINUTES=5
# IMAP_ENABLED=true
# IMAP_INTERVAL_SECONDS=60
# IMAP_SOCKET_TIMEOUT_SECONDS=600
# RELOGIN_TIMEOUT_MINUTES=10
# BROWSER_CHANNEL=msedge
# HEADLESS=false

# 本机 Web 控制台（均可选）
# DASHBOARD_PORT=3765
# DASHBOARD_AUTO_OPEN=true

# 成绩通知持久化队列（均可选）
# OUTBOX_POLL_INTERVAL_SECONDS=30
# OUTBOX_RETRY_BASE_SECONDS=60
# OUTBOX_RETRY_MAX_SECONDS=3600
# OUTBOX_RETENTION_DAYS=30

# 看门狗参数（均可选）
# WATCHDOG_AUTO_RESTART=true
# WATCHDOG_INTERVAL_MINUTES=5
# WATCHDOG_HEARTBEAT_MAX_AGE_MINUTES=3
# HEARTBEAT_INTERVAL_SECONDS=30
