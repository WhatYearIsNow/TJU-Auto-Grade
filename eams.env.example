# EAMS 查成绩助手配置
# 复制此文件为 eams.env 并填写你的信息

# 天津大学教务系统登录凭据
EAMS_USERNAME=你的学号
EAMS_PASSWORD=你的密码

# QQ邮箱 SMTP 配置 (用于发送成绩报告)
# 授权码获取: QQ邮箱 → 设置 → 账户 → POP3/SMTP服务 → 开启 → 获取授权码
QQ_EMAIL=你的QQ号@qq.com
QQ_SMTP_CODE=你的QQ邮箱授权码
NOTIFY_EMAIL=接收通知的邮箱(可选，默认发给自己)

# 千问 API Key (可选，用于 AI 自动识别验证码)
# 获取: https://bailian.console.aliyun.com/
# DASHSCOPE_API_KEY=sk-xxxx
