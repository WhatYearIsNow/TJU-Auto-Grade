{
  "name": "tju-auto-grade",
  "version": "2.1.0",
  "description": "天津大学自动查分系统 — 常驻监控成绩变化，邮件通知",
  "private": true,
  "license": "MIT",
  "author": "WhatYearIsNow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhatYearIsNow/tju-auto-grade.git"
  },
  "bugs": {
    "url": "https://github.com/WhatYearIsNow/tju-auto-grade/issues"
  },
  "homepage": "https://github.com/WhatYearIsNow/tju-auto-grade#readme",
  "keywords": [
    "tju",
    "eams",
    "grade-monitor",
    "playwright",
    "nodejs"
  ],
  "main": "dashboard.js",
  "scripts": {
    "build": "node scripts/build_dashboard_html.js",
    "build:check": "node scripts/build_dashboard_html.js --check",
    "prestart": "npm run build",
    "start": "node dashboard.js",
    "predashboard": "npm run build",
    "dashboard": "node dashboard.js",
    "monitor": "node eams_grade_checker_v2.js",
    "start:legacy": "node eams_grade_checker.js",
    "watchdog": "node watchdog.js",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "test:ui": "python scripts/run_ui_tests.py",
    "check": "node scripts/check.js",
    "validate": "npm run check && npm run build:check && npm test",
    "verify": "node eams_grade_checker_v2.js --verify",
    "test:email": "node test_email.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "nodemailer": "^9.0.5",
    "playwright": "^1.59.1"
  }
}
